# Docker Compose defaults (backend connects to service names inside the compose network).
# For running the API directly on your computer, use:
# SQL_URL=postgresql+psycopg://postgres:password@localhost:5433/studyflow
# REDIS_URL=redis://localhost:6379/0

SQL_URL=postgresql+psycopg://postgres:password@postgresql:5432/studyflow
REDIS_URL=redis://redis:6379/0
SECRET_KEY=replace_with_a_long_random_value
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Configure an email provider before using OTP signup.
BREVO_API_KEY=replace_with_your_brevo_api_key
